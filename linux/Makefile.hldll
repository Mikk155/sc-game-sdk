	$(SERVER_CRYPTOPP_OBJ_DIR)/rdtables.o \
	$(SERVER_CRYPTOPP_OBJ_DIR)/rijndael.o \
	$(SERVER_CRYPTOPP_OBJ_DIR)/rijndael_simd.o \
	$(SERVER_CRYPTOPP_OBJ_DIR)/sha.o \
	$(SERVER_CRYPTOPP_OBJ_DIR)/sha_simd.o \
	$(SERVER_CRYPTOPP_OBJ_DIR)/sse_simd.o \
	$(SERVER_CRYPTOPP_OBJ_DIR)/strciphr.o

all: dirs server.$(SHLIBEXT)

dirs:
	-mkdir $(BUILD_OBJ_DIR)
	-mkdir $(HLDLL_OBJ_DIR)
	-mkdir $(HLWPN_OBJ_DIR)
	-mkdir $(PM_OBJ_DIR)
	-mkdir $(GAME_SHARED_OBJ_DIR)
	-mkdir $(ANGELSCRIPT_OBJ_DIR)

server.$(SHLIBEXT): $(HLDLL_OBJS) $(HLWPN_OBJS) $(PM_OBJS) $(GAME_SHARED_OBJS) $(ANGELSCRIPT_OBJS) $(SVEN_SCRIPT_RUNTIME_LIB) $(SERVER_CRYPTOPP_OBJS)
	$(CC) $(LDFLAGS) $(SHLIBLDFLAGS) -o $(BUILD_DIR)/$@ $(HLDLL_OBJS) $(HLWPN_OBJS) $(PM_OBJS) $(GAME_SHARED_OBJS) $(ANGELSCRIPT_OBJS) $(SVEN_SCRIPT_RUNTIME_LIB) $(SERVER_CRYPTOPP_OBJS) -lcurl
	
$(SVEN_SCRIPT_RUNTIME_LIB): $(SVEN_SCRIPT_RUNTIME_OBJS)
	$(AR) rcs $@ $^

$(HLWPN_OBJ_DIR)/%.o : $(HLWPN_SRC_DIR)/%.cpp
	$(DO_HLWPN_CC)

$(HLDLL_OBJ_DIR)/%.o : $(HLDLL_SRC_DIR)/%.cpp
	$(DO_HLDLL_CC)

$(HLDLL_OBJ_DIR)/donid_miniz.o : $(SOURCE_DIR)/external/miniz/miniz.c
	$(DO_HLDLL_CC)

$(PM_OBJ_DIR)/%.o : $(PM_SRC_DIR)/%.cpp
	$(DO_PM_CC)

$(GAME_SHARED_OBJ_DIR)/%.o : $(GAME_SHARED_SRC_DIR)/%.cpp
	$(DO_GAME_SHARED_CC)

$(ANGELSCRIPT_OBJ_DIR)/%.o : $(ANGELSCRIPT_SRC_DIR)/%.cpp
	$(DO_ANGELSCRIPT_CC)

$(ANGELSCRIPT_OBJ_DIR)/contextmgr.o : $(ANGELSCRIPT_ADDON_DIR)/contextmgr/contextmgr.cpp
	$(DO_ANGELSCRIPT_CC)

$(ANGELSCRIPT_OBJ_DIR)/debugger.o : $(ANGELSCRIPT_ADDON_DIR)/debugger/debugger.cpp
	$(DO_ANGELSCRIPT_CC)

$(ANGELSCRIPT_OBJ_DIR)/scriptany.o : $(ANGELSCRIPT_ADDON_DIR)/scriptany/scriptany.cpp
	$(DO_ANGELSCRIPT_CC)

$(ANGELSCRIPT_OBJ_DIR)/scripthandle.o : $(ANGELSCRIPT_ADDON_DIR)/scripthandle/scripthandle.cpp
	$(DO_ANGELSCRIPT_CC)

$(ANGELSCRIPT_OBJ_DIR)/scriptarray.o : $(ANGELSCRIPT_ADDON_DIR)/scriptarray/scriptarray.cpp
	$(DO_ANGELSCRIPT_CC)

$(ANGELSCRIPT_OBJ_DIR)/scriptmath.o : $(ANGELSCRIPT_ADDON_DIR)/scriptmath/scriptmath.cpp
	$(DO_ANGELSCRIPT_CC) -DAS_USE_FLOAT=1

$(ANGELSCRIPT_OBJ_DIR)/weakref.o : $(ANGELSCRIPT_ADDON_DIR)/weakref/weakref.cpp
	$(DO_ANGELSCRIPT_CC)

$(ANGELSCRIPT_OBJ_DIR)/scriptgrid.o : $(ANGELSCRIPT_ADDON_DIR)/scriptgrid/scriptgrid.cpp
	$(DO_ANGELSCRIPT_CC)

$(ANGELSCRIPT_OBJ_DIR)/scriptmathcomplex.o : $(ANGELSCRIPT_ADDON_DIR)/scriptmath/scriptmathcomplex.cpp
	$(DO_ANGELSCRIPT_CC)

$(ANGELSCRIPT_OBJ_DIR)/scripthelper.o : $(ANGELSCRIPT_ADDON_DIR)/scripthelper/scripthelper.cpp
	$(DO_ANGELSCRIPT_CC)

$(ANGELSCRIPT_OBJ_DIR)/scriptbuilder.o : $(ANGELSCRIPT_ADDON_DIR)/scriptbuilder/scriptbuilder.cpp
	$(DO_ANGELSCRIPT_CC)

clean:
	-rm -rf $(GAME_SHARED_OBJ_DIR)
	-rm -rf $(PM_OBJ_DIR)
	-rm -rf $(HLWPN_OBJ_DIR)
	-rm -rf $(HLDLL_OBJ_DIR)
	-rm -f hl_$(ARCH).$(SHLIBEXT)

$(HLDLL_OBJ_DIR)/interface.o : $(PUBLIC_SRC_DIR)/interface.cpp
	$(DO_HLDLL_CC)

# The custom-entity creation interceptor catches C++ factory exceptions.
$(HLDLL_OBJ_DIR)/cbase.o: CFLAGS += -fexceptions

$(SERVER_CRYPTOPP_OBJ_DIR)/gcm_simd.o: CFLAGS += -mssse3 -mpclmul
$(SERVER_CRYPTOPP_OBJ_DIR)/rijndael_simd.o: CFLAGS += -msse4.1 -maes
$(SERVER_CRYPTOPP_OBJ_DIR)/sha_simd.o: CFLAGS += -msse4.2 -msha
$(SERVER_CRYPTOPP_OBJ_DIR)/sse_simd.o: CFLAGS += -msse2

$(SERVER_CRYPTOPP_OBJ_DIR):
	mkdir -p $@

$(SERVER_CRYPTOPP_OBJ_DIR)/%.o : $(SERVER_CRYPTOPP_SRC_DIR)/%.cpp | $(SERVER_CRYPTOPP_OBJ_DIR)
	$(CPLUS) $(CFLAGS) $(SHLIBCFLAGS) -o $@ -c $<

$(ANGELSCRIPT_OBJ_DIR)/serializer.o : $(ANGELSCRIPT_ADDON_DIR)/serializer/serializer.cpp
	$(DO_ANGELSCRIPT_CC)
