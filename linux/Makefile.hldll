#
# HL game library Makefile for x86 Linux
#
# Feb 2001 by Leon Hartwig (hartwig@valvesoftware.com)
#

HLDLL_SRC_DIR=$(SOURCE_DIR)/dlls
HLWPN_SRC_DIR=$(HLDLL_SRC_DIR)/wpn_shared

HLDLL_OBJ_DIR=$(BUILD_OBJ_DIR)/hldll
HLWPN_OBJ_DIR=$(HLDLL_OBJ_DIR)/wpn_shared
PM_OBJ_DIR=$(HLDLL_OBJ_DIR)/pm_shared
GAME_SHARED_OBJ_DIR=$(HLDLL_OBJ_DIR)/game_shared
ANGELSCRIPT_SRC_DIR=$(SOURCE_DIR)/external/angelscript/sdk/angelscript/source
ANGELSCRIPT_ADDON_DIR=$(SOURCE_DIR)/external/angelscript/sdk/add_on
ANGELSCRIPT_OBJ_DIR=$(HLDLL_OBJ_DIR)/angelscript
SERVER_CRYPTOPP_SRC_DIR=$(SOURCE_DIR)/external/cryptopp
SERVER_CRYPTOPP_OBJ_DIR=$(HLDLL_OBJ_DIR)/cryptopp

#CFLAGS=$(BASE_CFLAGS) $(ARCH_CFLAGS) $(SHLIBCFLAGS) -DCLIENT_WEAPONS -DDISABLE_VEC_ORIGIN
CFLAGS=$(BASE_CFLAGS)  $(ARCH_CFLAGS)  -DCLIENT_WEAPONS -DDISABLE_VEC_ORIGIN -DAS_PROCESS_METADATA=0 -DAS_USE_STLNAMES=1 -DAS_USE_ACCESSORS=0
#-O3 -ffast-math -fno-strength-reduce

HLDLL_INCLUDEDIRS=-I$(ENGINE_SRC_DIR) -I$(COMMON_SRC_DIR) -I$(PM_SRC_DIR) -I$(GAME_SHARED_SRC_DIR) -I$(PUBLIC_SRC_DIR) -I$(SOURCE_DIR)/external/angelscript/sdk/angelscript/include
HLWPN_INCLUDEDIRS=-I$(HLDLL_SRC_DIR) -I$(ENGINE_SRC_DIR) -I$(COMMON_SRC_DIR) -I$(PM_SRC_DIR) -I$(PUBLIC_SRC_DIR)
PM_INCLUDEDIRS=-I$(HLDLL_SRC_DIR) -I$(GAME_SHARED_SRC_DIR) -I$(COMMON_SRC_DIR) -I$(ENGINE_SRC_DIR) -I$(PUBLIC_SRC_DIR)
GAME_SHARED_INCLUDEDIRS=-I$(HLDLL_SRC_DIR) -I$(ENGINE_SRC_DIR) -I$(COMMON_SRC_DIR) -I$(PM_SRC_DIR) -I$(PUBLIC_SRC_DIR)

LDFLAGS= -lm -lstdc++ -ldl -lpthread

DO_HLDLL_CC=$(CC) $(HLDLL_INCLUDEDIRS) $(CFLAGS) -o $@ -c $<
DO_HLWPN_CC=$(CC) $(HLWPN_INCLUDEDIRS) $(CFLAGS) -o $@ -c $<
DO_PM_CC=$(CC) $(PM_INCLUDEDIRS) $(CFLAGS) -o $@ -c $<
DO_GAME_SHARED_CC=$(CC) $(GAME_SHARED_INCLUDEDIRS) $(CFLAGS) -o $@ -c $<
DO_ANGELSCRIPT_CC=$(CC) $(CFLAGS) -I$(SOURCE_DIR)/external/angelscript/sdk/angelscript/include -fPIC -DAS_NO_EXCEPTIONS -o $@ -c $<

#####################################################################

