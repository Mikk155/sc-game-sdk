SERVER_CRYPTOPP_OBJS = \
	$(SERVER_CRYPTOPP_OBJ_DIR)/algebra.o \
	$(SERVER_CRYPTOPP_OBJ_DIR)/algparam.o \
	$(SERVER_CRYPTOPP_OBJ_DIR)/allocate.o \
	$(SERVER_CRYPTOPP_OBJ_DIR)/asn.o \
