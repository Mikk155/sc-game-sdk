	$(CRYPTOPP_OBJ_DIR)/osrng.o \
	$(CRYPTOPP_OBJ_DIR)/primetab.o \
	$(CRYPTOPP_OBJ_DIR)/pubkey.o \
	$(CRYPTOPP_OBJ_DIR)/queue.o \
	$(CRYPTOPP_OBJ_DIR)/randpool.o \
	$(CRYPTOPP_OBJ_DIR)/rdtables.o \
	$(CRYPTOPP_OBJ_DIR)/rijndael.o \
	$(CRYPTOPP_OBJ_DIR)/rijndael_simd.o \
	$(CRYPTOPP_OBJ_DIR)/sha.o \
